# Google Sheets store for /register and /login (src/modules/auth/server/sheets.ts).
# 1. Google Cloud console → enable "Google Sheets API" → create a service account → add a JSON key.
# 2. Share the spreadsheet with the service account email as Editor.
# Leave these unset to use the in-browser mock auth instead.
NEXT_PUBLIC_AUTH_STORE=sheets
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" from the JSON key, in quotes, with \n escapes kept.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Signs the httpOnly session cookie (afwar_sid) set by /api/auth/login and /register.
# At least 32 random characters, e.g. `openssl rand -base64 48`. Required in production.
AUTH_SECRET=

# Public origin of the site, for the sitemap, robots.txt and social-preview tags.
NEXT_PUBLIC_SITE_URL=https://afvar.com
